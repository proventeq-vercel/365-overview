{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/storage-optimisation",
        "http://localhost:4173/onedrive-usage",
        "http://localhost:4173/help",
        "http://localhost:4173/help/reports/storage-optimisation"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 1 }],
        "categories:accessibility": ["warn", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 1 }],
        "categories:seo": ["warn", { "minScore": 1 }],
        "color-contrast": ["warn", { "minScore": 1 }],
        "document-title": ["warn", { "minScore": 1 }],
        "html-has-lang": ["warn", { "minScore": 1 }],
        "image-alt": ["warn", { "minScore": 1 }],
        "label": ["warn", { "minScore": 1 }],
        "errors-in-console": ["warn", { "minScore": 1 }],
        "uses-text-compression": ["warn", { "minScore": 1 }],
        "csp-xss": ["warn", { "maxLength": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}
