# Build-time Vite env vars.
#
# VITE_USE_MOCK: set to "true" to run the app on built-in fixture data with NO
# MSAL and NO /env.json — the fastest way to explore the UI, and the mode used
# by the unit tests and Playwright e2e.
#
# Live-mode auth config (client id, authority, redirect uri) is NOT set here.
# It is loaded at runtime from /env.json — copy public/env.sample.json to
# public/env.json and fill in your values.
VITE_USE_MOCK=false
