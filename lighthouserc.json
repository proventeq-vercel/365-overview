{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/storage-optimisation",
        "http://localhost:4173/onedrive-usage",
        "http://localhost:4173/help",
        "http://localhost:4173/help/reports/storage-optimisation"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "document-title": ["error", { "minScore": 1 }],
            "html-has-lang": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "label": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "minScore": 1 }],
            "uses-text-compression": ["error", { "minScore": 1 }],
            "csp-xss": ["error", { "maxLength": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/help",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "color-contrast": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/storage-optimisation$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "color-contrast": ["error", { "maxLength": 86 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/onedrive-usage$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "color-contrast": ["error", { "maxLength": 64 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-reports" }
  }
}
