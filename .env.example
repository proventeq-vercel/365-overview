# Build-time Vite env vars. Copy to .env for local dev (or set these in your
# Vercel project's Environment Variables). All client-side vars must be prefixed
# with VITE_ and are baked into the bundle at build time.

# VITE_USE_MOCK: set to "true" to run the app on built-in fixture data with NO
# MSAL and NO auth config — the fastest way to explore the UI, and the mode used
# by the unit tests and Playwright e2e. When "true", the VITE_* auth vars below
# are not required.
VITE_USE_MOCK=false

# VITE_MOCK_SCENARIO: which fixture tenant mock mode serves. One of
# healthy (default) | over-entitlement | concealed | short-history.
# Ignored unless VITE_USE_MOCK=true.
VITE_MOCK_SCENARIO=healthy

# VITE_FEATURES: comma-separated feature flags (same naming as the Proventeq 365
# licence flags). Each report in src/features/registry.ts requires one flag;
# only reports whose flag is listed are built in. With one report enabled the
# app has no menu; with two or more a floating report menu appears. Unset =
# the storage overview only.
#   optimization.storage.report.overview   Storage Optimisation
#   optimization.storage.report.onedrive   OneDrive Usage
VITE_FEATURES=optimization.storage.report.overview

# Modes from the URL. The three switches above are the app's "modes" and each
# can also be set per browser tab with a search param — handy for demos and for
# checking a report without a rebuild:
#   ?features=optimization.storage.report.overview,optimization.storage.report.onedrive
#   ?mock=true            ?mock=false
#   ?scenario=concealed   (healthy | over-entitlement | concealed | short-history)
# A param present in the URL is remembered for the tab (sessionStorage), so
# navigating and the sign-in redirect keep it; an empty value (?features=)
# clears that one override and ?modes=reset clears them all. A new tab starts
# from this file again.
#
# VITE_MODES_LOCKED: set to "true" to ignore the URL entirely and run exactly
# what the env says. This is the one switch the URL can never change — set it
# on the production deployment.
VITE_MODES_LOCKED=false

# Live-mode auth config (Entra ID). All optional: unset (or empty) values fall
# back to the built-in registration (DEFAULT_AUTH in src/config/appConfig.ts,
# the multi-tenant "Proventeq365 - Storage Analyser" app) and to the page's own origin as the redirect URI.
# The Entra app registration must be of type "SPA" with the redirect URI registered.
VITE_CLIENT_ID=
# 'organizations' = any work/school tenant (needs a multi-tenant registration). A tenant GUID pins the app to one tenant.
VITE_AUTHORITY_URI=
VITE_REDIRECT_URI=
