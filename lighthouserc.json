{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/storage-optimisation",
        "http://localhost:4173/onedrive-usage",
        "http://localhost:4173/help",
        "http://localhost:4173/help/reports/storage-optimisation"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "accesskeys": ["error", { "minScore": 1 }],
            "aria-allowed-attr": ["error", { "minScore": 1 }],
            "aria-allowed-role": ["error", { "minScore": 1 }],
            "aria-command-name": ["error", { "minScore": 1 }],
            "aria-conditional-attr": ["error", { "minScore": 1 }],
            "aria-deprecated-role": ["error", { "minScore": 1 }],
            "aria-dialog-name": ["error", { "minScore": 1 }],
            "aria-hidden-body": ["error", { "minScore": 1 }],
            "aria-hidden-focus": ["error", { "minScore": 1 }],
            "aria-input-field-name": ["error", { "minScore": 1 }],
            "aria-meter-name": ["error", { "minScore": 1 }],
            "aria-progressbar-name": ["error", { "minScore": 1 }],
            "aria-prohibited-attr": ["error", { "minScore": 1 }],
            "aria-required-attr": ["error", { "minScore": 1 }],
            "aria-required-children": ["error", { "minScore": 1 }],
            "aria-required-parent": ["error", { "minScore": 1 }],
            "aria-roles": ["error", { "minScore": 1 }],
            "aria-text": ["error", { "minScore": 1 }],
            "aria-toggle-field-name": ["error", { "minScore": 1 }],
            "aria-tooltip-name": ["error", { "minScore": 1 }],
            "aria-treeitem-name": ["error", { "minScore": 1 }],
            "aria-valid-attr-value": ["error", { "minScore": 1 }],
            "aria-valid-attr": ["error", { "minScore": 1 }],
            "button-name": ["error", { "minScore": 1 }],
            "bypass": ["error", { "minScore": 1 }],
            "definition-list": ["error", { "minScore": 1 }],
            "dlitem": ["error", { "minScore": 1 }],
            "document-title": ["error", { "minScore": 1 }],
            "duplicate-id-aria": ["error", { "minScore": 1 }],
            "form-field-multiple-labels": ["error", { "minScore": 1 }],
            "frame-title": ["error", { "minScore": 1 }],
            "heading-order": ["error", { "minScore": 1 }],
            "html-has-lang": ["error", { "minScore": 1 }],
            "html-lang-valid": ["error", { "minScore": 1 }],
            "html-xml-lang-mismatch": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "image-redundant-alt": ["error", { "minScore": 1 }],
            "input-button-name": ["error", { "minScore": 1 }],
            "input-image-alt": ["error", { "minScore": 1 }],
            "label": ["error", { "minScore": 1 }],
            "link-in-text-block": ["error", { "minScore": 1 }],
            "link-name": ["error", { "minScore": 1 }],
            "list": ["error", { "minScore": 1 }],
            "listitem": ["error", { "minScore": 1 }],
            "meta-refresh": ["error", { "minScore": 1 }],
            "meta-viewport": ["error", { "minScore": 1 }],
            "object-alt": ["error", { "minScore": 1 }],
            "select-name": ["error", { "minScore": 1 }],
            "skip-link": ["error", { "minScore": 1 }],
            "tabindex": ["error", { "minScore": 1 }],
            "table-duplicate-name": ["error", { "minScore": 1 }],
            "target-size": ["error", { "minScore": 1 }],
            "td-headers-attr": ["error", { "minScore": 1 }],
            "th-has-data-cells": ["error", { "minScore": 1 }],
            "valid-lang": ["error", { "minScore": 1 }],
            "video-caption": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "minScore": 1 }],
            "uses-text-compression": ["error", { "minScore": 1 }],
            "csp-xss": ["error", { "maxLength": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/help",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "color-contrast": ["error", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/storage-optimisation$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "color-contrast": ["error", { "maxLength": 90 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/onedrive-usage$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.96 }],
            "color-contrast": ["error", { "maxLength": 70 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-reports" }
  }
}
